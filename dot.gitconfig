[core]
  excludesfile = ~/dotfiles/gitignore
  quotepath = false
	pager = delta

[commit]
  template = ~/dotfiles/gitmessage

[alias]
  push-f = push --force-with-lease
  plog = log -20 --date=short --pretty='format:%C(yellow)%h %C(green)%cd %C(blue)%an%C(red)%d %C(reset)%s'
  ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
  stash-rename = "!_() { rev=$(git rev-parse $1) && git stash drop $1 || exit 1 ; git stash store -m \"$2\" $rev; }; _"
  tb = "!_() { git add . && git commit -m \":contstruction: backup - `date +%Y/%m/%d-%H:%M`\" --no-verify && git reset HEAD~1; }; _"
  di = diff --cached
  co = checkout
  br = branch
  ci = commit
  st = status

[http]
  postBuffer = 1048576000

[push]
  default = simple
  autoSetupRemote = true

[init]
  defaultBranch = main

[pull]
  ff = only
  rebase = true

[interactive]
	diffFilter = delta --color-only

[delta]
	dark = true
	navigate = true
	side-by-side = true
	line-numbers = true

[diff]
	tool = difftastic
  external = difft

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[pager]
  difftool = true

[merge]
  tool = vimdiff
	conflictStyle = zdiff3
